    obs_test_sanitize(test_portal_uninhibit address,undefined)
    add_dependencies(cmocka-tests test_portal_uninhibit)
    add_test(test_portal_uninhibit ${CMAKE_CURRENT_BINARY_DIR}/test_portal_uninhibit)
    set_tests_properties(test_portal_uninhibit PROPERTIES TIMEOUT 30)
